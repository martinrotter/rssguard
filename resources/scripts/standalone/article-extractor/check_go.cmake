execute_process(
  COMMAND "${GO_EXECUTABLE}" env GOVERSION
  WORKING_DIRECTORY "${GO_SOURCE_DIR}"
  OUTPUT_VARIABLE GO_VERSION
  OUTPUT_STRIP_TRAILING_WHITESPACE
  COMMAND_ERROR_IS_FATAL ANY
)
string(REGEX REPLACE "^go" "" GO_VERSION "${GO_VERSION}")
file(STRINGS "${GO_SOURCE_DIR}/go.mod" GO_MIN_VERSION REGEX "^go ")
string(REGEX REPLACE "^go " "" GO_MIN_VERSION "${GO_MIN_VERSION}")
if(GO_VERSION VERSION_LESS GO_MIN_VERSION)
  message(FATAL_ERROR "The article extractor requires Go ${GO_MIN_VERSION} or newer (found ${GO_VERSION}).")
endif()
file(CONFIGURE OUTPUT "${GO_VERSION_FILE}" CONTENT "${GO_VERSION}\n")
